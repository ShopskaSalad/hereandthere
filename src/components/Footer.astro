---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer>
  <div class="container footer-grid">
    <div>
      <p class="footer-title">Between Borders</p>
      <p class="footer-note">A public notebook about stories, speaking, and becoming.</p>
    </div>

    <div class="footer-links">
      <a href={`${base}about/`}>About</a>
      <a href={`${base}rss.xml`}>RSS</a>
      <a href="https://x.com/akinkamilov" rel="me noopener" target="_blank">X ↗</a>
    </div>

    <p class="copyright">© {year} Kamil Akin</p>
  </div>
</footer>

<style>
  footer {
    margin-top: 7rem;
    padding: 3rem 0;
    border-top: 1px solid var(--line);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr auto;
    align-items: end;
    gap: 2rem;
  }

  .footer-title {
    margin: 0 0 0.25rem;
    font-family: "Newsreader", Georgia, serif;
    font-size: 1.45rem;
  }

  .footer-note,
  .copyright {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .footer-links {
    display: flex;
    gap: 1rem;
    font-size: 0.88rem;
  }

  @media (max-width: 44rem) {
    .footer-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
