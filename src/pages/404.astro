---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page not found">
  <section class="missing container">
    <p class="eyebrow">404 · Between places</p>
    <h1>This path ends here.</h1>
    <p>The page may have moved, or perhaps this story has not been written yet.</p>
    <a class="button" href={base}>Return home</a>
  </section>
</BaseLayout>

<style>
  .missing {
    display: grid;
    min-height: 60vh;
    place-content: center;
    text-align: center;
  }

  h1 {
    margin-bottom: 1rem;
  }

  .missing > p:not(.eyebrow) {
    color: var(--muted);
    font-family: "Newsreader", Georgia, serif;
    font-size: 1.35rem;
  }

  .button {
    margin: 1rem auto 0;
  }
</style>
