---
import BaseLayout from "../layouts/BaseLayout.astro";

const accounts = [
  {
    name: "X",
    handle: "@akinkamilov",
    href: "https://x.com/akinkamilov",
  },
  {
    name: "LinkedIn",
    handle: "kamil-akin",
    href: "https://www.linkedin.com/in/kamil-akin/",
  },
];
---

<BaseLayout title="About Kamil" description="Kamil Akin on X and LinkedIn.">
  <section class="about container">
    <p class="eyebrow">About</p>
    <h1>Kamil Akin</h1>

    <ul>
      {
        accounts.map((account) => (
          <li>
            <a href={account.href} rel="me noopener noreferrer" target="_blank">
              <span class="icon" aria-hidden="true">
                {account.name === "X" ? (
                  <svg viewBox="0 0 24 24">
                    <path
                      fill="currentColor"
                      d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                    />
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24">
                    <path
                      fill="currentColor"
                      d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45C23.2 24 24 23.23 24 22.27V1.73C24 .77 23.2 0 22.23 0z"
                    />
                  </svg>
                )}
              </span>
              <span class="label">
                <strong>{account.name}</strong>
                <span>{account.handle}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .about {
    padding-block: 6rem 2rem;
  }

  h1 {
    margin-bottom: 3rem;
    font-size: clamp(3rem, 8vw, 5rem);
  }

  ul {
    max-width: 28rem;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  a {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1.15rem 0.15rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  a:hover .icon,
  a:focus-visible .icon {
    color: var(--surface);
    background: var(--ink);
    border-color: var(--ink);
  }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .icon {
    display: grid;
    flex: 0 0 auto;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: 50%;
    transition: 160ms ease;
  }

  svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .label {
    display: grid;
    gap: 0.1rem;
  }

  strong {
    font-size: 1.05rem;
    font-weight: 500;
  }

  .label span {
    color: var(--muted);
    font-size: 0.92rem;
  }

  @media (max-width: 42rem) {
    .about {
      padding-block: 4rem 1rem;
    }
  }
</style>
