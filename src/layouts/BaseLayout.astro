---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const {
  title = "Between Borders",
  description = "Kamil Akin's public notebook about storytelling, speaking and the road toward a Toastmasters national contest.",
  image,
  article = false,
} = Astro.props;

const pageTitle = title === "Between Borders" ? title : `${title} — Between Borders`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const defaultImage = new URL(`${import.meta.env.BASE_URL}social-card.svg`, Astro.site);
const socialImage = image ? new URL(image, Astro.site) : defaultImage;

const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiScript = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL || "https://cloud.umami.is/script.js";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title="Between Borders" href={`${import.meta.env.BASE_URL}rss.xml`} />

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content="#f6f4ef" />
    <title>{pageTitle}</title>

    {umamiId && <script async defer src={umamiScript} data-website-id={umamiId}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
